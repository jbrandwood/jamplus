rule C.Toolchain.clang.emscripten-shared {
}


rule C.emscripten._ApplicationFromObjects_CleanIntermediates {
    # Clean the extra files.
    local sufexe = $(_linkTargets[1]:S) ;
    local sufs = .wasm ;
    if $(sufexe) = .html {
        sufs += .js ;
    }
    local zap = $(_tBINDING:S=$(sufs)) ;
    MakeLocate $(zap) : $(outputPath) ;
    Clean $(C.ACTIVE_TOOLCHAIN_CLEAN_TARGET) : $(zap) ;
    CLEAN.KEEP_TARGETS += $(zap) ;

    Depends $(zap) : $(_linkTargets) ;
}


rule C.emscripten._ApplicationFromObjects_LinkFlags {
    local _t.wasm = $(_linkTargets[1]:S=.wasm) ;
    local _tBINDING.wasm = [ C._retrieveOutputName : .wasm ] ;
    BINDING on $(_t.wasm) = $(_tBINDING.wasm) ;
    _linkTargets += $(_t.wasm) ;

    linkFlags += "--js-library $(JS_LIBS:T:Z=$(C.ACTIVE_TOOLCHAIN_TARGET))" ;
    linkFlags += "--pre-js $(JS_PRE:T:Z=$(C.ACTIVE_TOOLCHAIN_TARGET))" ;
    linkFlags += "--post-js $(JS_POST:T:Z=$(C.ACTIVE_TOOLCHAIN_TARGET))" ;
    #linkFlags += "--externs $(JS_EXTERNS:T:Z=$(C.ACTIVE_TOOLCHAIN_TARGET))" ;
}


rule C.emscripten._ApplicationFromObjects_Setup {
    if html in $(OPTIONS) {
        SUFEXE on $(C.ACTIVE_TOOLCHAIN_TARGET) = .html ;
    }
}


rule C.emscripten._Inherits {
    local public_JS_LIBS = $(PUBLIC_JS_LIBS:Z=$(inheritsTarget)) ;
    if $(public_JS_LIBS) {
        JS_LIBS on $(C.ACTIVE_TOOLCHAIN_TARGET) |= $(public_JS_LIBS) ;
        PUBLIC_JS_LIBS on $(C.ACTIVE_TOOLCHAIN_TARGET) |= $(public_JS_LIBS) ;
    }

    local public_JS_PRE = $(PUBLIC_JS_PRE:Z=$(inheritsTarget)) ;
    if $(public_JS_PRE) {
        JS_PRE on $(C.ACTIVE_TOOLCHAIN_TARGET) |= $(public_JS_PRE) ;
        PUBLIC_JS_PRE on $(C.ACTIVE_TOOLCHAIN_TARGET) |= $(public_JS_PRE) ;
    }

    local public_JS_POST = $(PUBLIC_JS_POST:Z=$(inheritsTarget)) ;
    if $(public_JS_POST) {
        JS_POST on $(C.ACTIVE_TOOLCHAIN_TARGET) |= $(public_JS_POST) ;
        PUBLIC_JS_POST on $(C.ACTIVE_TOOLCHAIN_TARGET) |= $(public_JS_POST) ;
    }

    local public_JS_EXTERNS = $(PUBLIC_JS_EXTERNS:Z=$(inheritsTarget)) ;
    if $(public_JS_EXTERNS) {
        JS_EXTERNS on $(C.ACTIVE_TOOLCHAIN_TARGET) |= $(public_JS_EXTERNS) ;
        PUBLIC_JS_EXTERNS on $(C.ACTIVE_TOOLCHAIN_TARGET) |= $(public_JS_EXTERNS) ;
    }
}


rule C.emscripten.JSLibraries TARGET : SOURCES : OPTIONS {
    TARGET = [ C.ActiveTarget $(TARGET) ] ;
    SOURCES = [ ExpandFileList $(SOURCES) : 0 : $(SEARCH_SOURCE) ] ;
    SOURCES = $(SOURCES:G=$(C.ACTIVE_TOOLCHAIN_TARGET_GRIST)) ;
    SEARCH on $(SOURCES) ?= $(SEARCH_SOURCE) ;
    JS_LIBS on $(C.ACTIVE_TOOLCHAIN_TARGET) |= $(SOURCES) ;
    if public in $(OPTIONS) {
        __PUBLIC on $(C.ACTIVE_TOOLCHAIN_TARGET) = true ;
        PUBLIC_JS_LIBS on $(C.ACTIVE_TOOLCHAIN_TARGET) |= $(SOURCES) ;
    }
}


