rule C.Toolchain.clang.win64-release {
    local targetFlags ;
    local isClangCl = $(CLANG-CL:Z=$(C.COMPILER_SUITE_SYMBOL)) ;
    if ! $(isClangCl) {
        targetFlags = -target x86_64-w64-mingw32 ;
    }
    C.Flags * : CC C++ M MM : -g -O2 $(targetFlags) -fms-extensions ;
    C.LinkFlags * : $(targetFlags) -fuse-ld=lld ;

    C.Toolchain.Helper.ReleaseSettings ;
}

