SubDir TOP ;

# Output all of our user-facing files into the bin/ directory.
BIN_PATH = $(SUBDIR)/bin ;

###############################################################################
# Create the lua54 shared library.
###############################################################################
{
    SubDir TOP/.deps/lua ;

    C.ActiveTarget lua54 ;

    # Tell Lua's code to export the appropriate functions to the DLL.
    C.Defines : LUA_BUILD_AS_DLL ;
    C.IncludeDirectories : lua ;
    C.OutputPath : $(BIN_PATH) ;
    C.Library : *@=**.c@=**.h@-**/lua.c@-**/luac.c@-**/onelua.c : shared ;
}

###############################################################################
# Create the lua executable.
###############################################################################
{
    SubDir TOP/.deps/lua ;

    C.ActiveTarget "lua" ;
    C.LinkLibraries : lua54 ;
    C.OutputPath : $(BIN_PATH) ;
    C.Application : lua.c ;
}

###############################################################################
# Build luasocket.
###############################################################################
{
    SubDir TOP/.deps/luasocket ;

    CopyFiles socket : $(BIN_PATH) : [ ExpandFileList src/*.lua@-**/mime.lua@-**/socket.lua ] ;
    CopyFiles socket : $(BIN_PATH) : src/socket.lua ;

    C.ActiveTarget socket ;

    local SRCS = src/*.c src/*.h src/*.lua ;
    if $(OS) = NT {
        C.ExcludeFromBuild :
            src/serial.c
            src/unix.c
            src/unixdgram.c
            src/unixstream.c
            src/usocket.c
        ;
    } else {
        C.ExcludeFromBuild : src/wsocket.c ;
    }

    C.Defines : LUASOCKET_EXPORTS ;

    if $(MSVCNT) {
        C.Defines : "LUASOCKET_API=__declspec(dllexport)" ;
    }

    if $(OS) = NT {
        C.LinkPrebuiltLibraries : ws2_32 ;
    }

    C.IncludeDirectories : ../lua ;
    C.OutputName : core ;
    C.OutputPath : $(BIN_PATH)/socket ;
    C.LinkLibraries : lua54 ;
    C.Library : $(SRCS) : module ;
    Depends all : socket ;
}

###############################################################################
# Build luasocket's mime library.
###############################################################################
{
    SubDir TOP/.deps/luasocket ;

    CopyFiles mime : $(BIN_PATH) : src/mime.lua ;

    C.ActiveTarget mime ;

    if $(MSVCNT) {
        C.Defines : "MIME_API=__declspec(dllexport)" ;
    }

    C.IncludeDirectories : ../lua ;
    C.OutputName : core ;
    C.OutputPath : $(BIN_PATH)/mime ;
    C.LinkLibraries : lua54 ;
    C.Library : src/mime.* : module ;
    Depends all : mime ;
}
