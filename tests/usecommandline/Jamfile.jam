DEPCACHE.standard = .jamdepcache ;
DEPCACHE = standard ;

actions TestAction {
	echo Executing test action for $(<)
	echo $(COMMAND_LINE_VERSION) >$(<)
}

rule TestVersion {
	return $(COMMAND_LINE_VERSION:E=2) ;
}

rule Test TARGET {
	Depends all : $(TARGET) ;
	Clean clean : $(TARGET) ;
	UseCommandLine $(TARGET) : [ TestVersion ] ;
	COMMAND_LINE_VERSION on $(TARGET) = [ TestVersion ] ;
	TestAction $(TARGET) ;
}

Test "1" ;
